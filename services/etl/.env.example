# Postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=content
POSTGRES_USER=content_user
POSTGRES_PASSWORD=content_password

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# Backoff settings
BATCH_SIZE=100
BACKOFF_SECONDS=5
